# encoder_prompt.onnx (export_onnx.py): stateless per call; caches travel in/out, streaming_asr owns them.
# max_batch_size 0 + full shapes: batching across streams is done by streaming_asr. Full I/O is spelled out because
# Triton's auto-complete turns max_batch_size 0 into 4 for graphs whose first dim is dynamic (serve.sh also passes
# --disable-auto-complete-config). CUDA EP arena capped to stay inside the card budget.
name: "encoder_prompt"
backend: "onnxruntime"
max_batch_size: 0
input [
  { name: "audio_signal" data_type: TYPE_FP32 dims: [ -1, 128, -1 ] },
  { name: "length" data_type: TYPE_INT64 dims: [ -1 ] },
  { name: "cache_last_channel" data_type: TYPE_FP32 dims: [ -1, 24, 56, 1024 ] },
  { name: "cache_last_time" data_type: TYPE_FP32 dims: [ -1, 24, 1024, 8 ] },
  { name: "cache_last_channel_len" data_type: TYPE_INT64 dims: [ -1 ] },
  { name: "prompt_index" data_type: TYPE_INT64 dims: [ -1 ] }
]
output [
  { name: "encoded" data_type: TYPE_FP32 dims: [ -1, 1024, -1 ] },
  { name: "encoded_len" data_type: TYPE_INT64 dims: [ -1 ] },
  { name: "cache_last_channel_next" data_type: TYPE_FP32 dims: [ -1, 24, -1, 1024 ] },
  { name: "cache_last_time_next" data_type: TYPE_FP32 dims: [ -1, 24, 1024, -1 ] },
  { name: "cache_last_channel_next_len" data_type: TYPE_INT64 dims: [ -1 ] }
]
instance_group [ { count: 1 kind: KIND_GPU gpus: [ 0 ] } ]
parameters { key: "cudnn_conv_algo_search" value: { string_value: "1" } }
parameters { key: "arena_extend_strategy" value: { string_value: "1" } }
parameters { key: "gpu_mem_limit" value: { string_value: "8589934592" } }
