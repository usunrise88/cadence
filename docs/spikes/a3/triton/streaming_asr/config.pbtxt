# Stateful front model: the sequence batcher routes every chunk of a stream (CORRID) to this instance and batches
# chunks of different streams together (oldest strategy). Parameters come from the export's streaming_cfg.json
# for the 80 ms profile ([56,0]): chunk 8 mel frames + 9 pre-encode cache frames = 17 frames per request.
name: "streaming_asr"
backend: "python"
max_batch_size: 64
sequence_batching {
  max_sequence_idle_microseconds: 30000000
  oldest { max_candidate_sequences: 256 preferred_batch_size: [ 16, 32, 64 ] max_queue_delay_microseconds: 2000 }
  control_input [
    { name: "START" control [ { kind: CONTROL_SEQUENCE_START fp32_false_true: [ 0, 1 ] } ] },
    { name: "END" control [ { kind: CONTROL_SEQUENCE_END fp32_false_true: [ 0, 1 ] } ] },
    { name: "CORRID" control [ { kind: CONTROL_SEQUENCE_CORRID data_type: TYPE_UINT64 } ] }
  ]
}
input [
  { name: "FEATS" data_type: TYPE_FP32 dims: [ 128, 17 ] },
  { name: "LEN" data_type: TYPE_INT64 dims: [ 1 ] }
]
output [ { name: "TOKENS" data_type: TYPE_INT32 dims: [ -1 ] } ]
instance_group [ { count: 1 kind: KIND_CPU } ]
parameters { key: "blank_id" value: { string_value: "13087" } }
parameters { key: "max_symbols" value: { string_value: "10" } }
parameters { key: "prompt_index" value: { string_value: "64" } }
parameters { key: "last_channel_cache_size" value: { string_value: "56" } }
parameters { key: "conv_cache" value: { string_value: "8" } }
