# Cadence toy worker — runtime `toy` (R45): python:3.12-slim, CPU PyTorch, the worker harness and the toy pack.
# It exists to keep the framework seams honest; it never trains a real model. Build context is the repository root:
#   docker build -f worker/Dockerfile.toy -t cadence-worker-toy:dev .
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1
# ffmpeg decodes the files a live transcription session uploads (toy_live; R47).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
# CPU wheels only (the CUDA build is ten times larger and useless here); the version follows worker/uv.lock.
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch==2.14.1" \
 && pip install "numpy>=1.26,<3"

COPY worker/pyproject.toml /src/worker/pyproject.toml
COPY worker/cadence_worker /src/worker/cadence_worker
COPY worker/packs/toy /src/worker/packs/toy
RUN pip install /src/worker /src/worker/packs/toy && rm -rf /src/worker

# defaults.yaml is the control plane's file (R11), packaged unchanged; the runtime descriptor names this image.
COPY control-plane/defaults/defaults.yaml /opt/cadence/defaults.yaml
COPY worker/runtime/toy.json /etc/cadence/runtime.json

# Non-root with the control plane's uid, so blobs in the shared content store (mode 0440) are readable both ways.
RUN groupadd --gid 65532 nonroot \
 && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /var/lib/cadence --shell /usr/sbin/nologin nonroot \
 && mkdir -p /var/lib/cadence/cas /var/lib/cadence/scratch /worker-credential \
 && chown -R 65532:65532 /var/lib/cadence /worker-credential

ARG CADENCE_VERSION=dev
ENV CADENCE_VERSION=${CADENCE_VERSION} \
    CADENCE_DEFAULTS_FILE=/opt/cadence/defaults.yaml \
    CADENCE_RUNTIME_FILE=/etc/cadence/runtime.json \
    CADENCE_CAS_DIR=/var/lib/cadence/cas \
    CADENCE_WORKER_SCRATCH=/var/lib/cadence/scratch \
    CADENCE_WORKER_GPU=off \
    HOME=/var/lib/cadence
USER 65532:65532
WORKDIR /var/lib/cadence
ENTRYPOINT ["python", "-m", "cadence_worker"]
CMD ["serve"]
