{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      ".git/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "uv run *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "pip install *": "ask",
      "uv add *": "ask",
      "uv pip install *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "git push *": "deny",
      "git remote *": "deny",
      "git config *": "deny",
      "sudo *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "docker *": "deny",
      "rm -rf /*": "deny",
      "env": "deny",
      "printenv *": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "cadence_*": "deny",
    "cadence_adoptions_list": "allow",
    "cadence_agentModels_list": "allow",
    "cadence_agentProfile_edit": "allow",
    "cadence_agentProfile_get": "allow",
    "cadence_aliases_get": "allow",
    "cadence_aliases_list": "allow",
    "cadence_aliases_set": "allow",
    "cadence_approvals_get": "allow",
    "cadence_approvals_list": "allow",
    "cadence_audit_list": "allow",
    "cadence_baseModels_get": "allow",
    "cadence_baseModels_list": "allow",
    "cadence_branches_accept": "allow",
    "cadence_branches_get": "allow",
    "cadence_branches_list": "allow",
    "cadence_branches_revert": "allow",
    "cadence_collections_get": "allow",
    "cadence_collections_list": "allow",
    "cadence_compute_get": "allow",
    "cadence_compute_list": "allow",
    "cadence_datasets_get": "allow",
    "cadence_datasets_list": "allow",
    "cadence_defaults_get": "allow",
    "cadence_events_list": "allow",
    "cadence_help_get": "allow",
    "cadence_help_search": "allow",
    "cadence_jobs_cancel": "allow",
    "cadence_jobs_get": "allow",
    "cadence_jobs_list": "allow",
    "cadence_jobs_wait": "allow",
    "cadence_policies_get": "allow",
    "cadence_projects_adopt": "allow",
    "cadence_projects_archive": "allow",
    "cadence_projects_edit": "allow",
    "cadence_projects_get": "allow",
    "cadence_projects_list": "allow",
    "cadence_projects_new": "allow",
    "cadence_projects_note": "allow",
    "cadence_projects_sync": "allow",
    "cadence_recipes_get": "allow",
    "cadence_recipes_list": "allow",
    "cadence_registry_search": "allow",
    "cadence_runs_new": "allow",
    "cadence_templates_get": "allow",
    "cadence_templates_list": "allow"
  }
}
