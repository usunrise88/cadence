# Bootstrap values only (R9); everything else is configured in Cadence.
POSTGRES_PASSWORD=change-me
CADENCE_LOG_LEVEL=info
CADENCE_CACHE_DIR=./cache
CADENCE_PORT=8080
# Master key of the secret store (R9): a file holding 32 bytes as base64; generated there on first start if missing.
# CADENCE_MASTER_KEY_FILE=/data/master.key
